{
  "name": "okfctl",
  "version": "0.1.0",
  "description": "Lifecycle tooling for Open Knowledge Format (OKF) v0.2 bundles \u2014 health reporting, draft\u2192stable promotion, index regeneration.",
  "type": "module",
  "bin": {
    "okfctl": "dist/cli.js",
    "okf": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "commands"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "lint": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "okf",
    "open-knowledge-format",
    "knowledge",
    "agents",
    "lifecycle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matzexp/okfctl.git"
  },
  "homepage": "https://github.com/matzexp/okfctl#readme",
  "bugs": {
    "url": "https://github.com/matzexp/okfctl/issues"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "minisearch": "^7.2.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
